<Project>
	<PropertyGroup>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0"/>
		<PackageVersion Include="DeclarativeCommandLine" Version="2.0.10"/>
		<PackageVersion Include="DeclarativeCommandLine.Generator" Version="2.0.10"/>
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13"/>
		<PackageVersion Include="Microsoft.VisualStudio.Threading" Version="18.12.1"/>
		<PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.363"/>
		<PackageVersion Include="Namotion.Reflection" Version="3.5.1"/>
		<PackageVersion Include="SharpHook" Version="8.0.0"/>
		<PackageVersion Include="System.Numerics.Vectors" Version="4.6.1"/>
		<PackageVersion Include="Tmds.DBus" Version="0.95.1"/>
		<PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1"/>
		<!-- Analyzers -->
		<PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1"/>
		<PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138"/>
		<PackageVersion Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556"/>
		<!-- Build -->
		<PackageVersion Include="Microsoft.Build" Version="18.11.0"/>
		<PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.11.0"/>
		<PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.11.0"/>
		<PackageVersion Include="NuGet.Packaging" Version="7.9.0"/>
		<PackageVersion Include="Nuke.Common" Version="10.1.0"/>
		<!-- GUI -->
		<PackageVersion Include="NotificationIcon.NET" Version="1.2.8"/>
		<PackageVersion Include="Photino.Blazor" Version="4.0.13"/>
		<PackageVersion Include="Radzen.Blazor" Version="12.1.3"/>
		<!-- HTTP API -->
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
		<PackageVersion Include="Scalar.AspNetCore" Version="2.18.0"/>
		<!-- Logging -->
		<PackageVersion Include="Serilog" Version="4.4.0"/>
		<PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0"/>
		<PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0"/>
		<PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0"/>
		<PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1"/>
		<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0"/>
		<!-- Serialization -->
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4"/>
		<PackageVersion Include="NJsonSchema" Version="11.6.1"/>
		<!-- Testing -->
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
		<PackageVersion Include="Moq" Version="4.21.0"/>
		<PackageVersion Include="MSTest" Version="4.5.1"/>
		<!-- Explicit transitives due to vulnerabilities -->
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13"/>
	</ItemGroup>
</Project>
