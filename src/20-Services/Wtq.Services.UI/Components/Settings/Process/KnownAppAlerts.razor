@code {
	const string WtFilename = "wt";
	const string WtProcName = "^WindowsTerminal$";

	[EditorRequired]
	[Parameter]
	public WtqAppOptions AppOpts { get; set; } = null!;
}

<RadzenAlert
	AllowClose="false"
	AlertStyle="AlertStyle.Secondary"
	Visible="@(AppOpts.FileName == WtFilename && AppOpts.ProcessName != WtProcName)"
>

	The filename suggests you're setting up <em>Windows Terminal</em>. Note that you need to set <em>Process name</em> to <em>@WtProcName</em>.

	<RadzenButton
		Variant="Variant.Text"
		Click="@(() => AppOpts.ProcessName = WtProcName)"
		Text="Click here"
		Size="ButtonSize.Small"
		ButtonStyle="ButtonStyle.Info"
	/> to do this now.
</RadzenAlert>