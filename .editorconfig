root = true

[*]
charset = utf-8
insert_final_newline = false
indent_style = tab
indent_size = 4
tab_width = 4

[*.yml]
indent_style = space
indent_size = 2

[*.cs]
stylecop.ordering.memberKindOrder = class, enum, field, property, constructor, method

# Enable everything
dotnet_diagnostic.severity = warning

