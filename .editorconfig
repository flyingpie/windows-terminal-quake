root = true

[*]
charset = utf-8
insert_final_newline = false
indent_style = tab
indent_size = 4
tab_width = 4

[*.yml]
indent_style = space
indent_size = 2

[*.cs]

# Enable everything
dotnet_diagnostic.severity = warning

# Disabled for this project.
dotnet_diagnostic.CA1031.severity    = none # CA1031      : Do not catch general exception types
dotnet_diagnostic.CA1824.severity    = none # CA1824      : Mark assemblies with NeutralResourcesLanguageAttribute
dotnet_diagnostic.CA1848.severity    = none # CA1848      : Use the LoggerMessage delegates
dotnet_diagnostic.CS1591.severity    = none # CS1591      : Missing XML comment for publicly visible type or member
dotnet_diagnostic.IDE0066.severity   = none # IDE0066     : Convert switch statement to expression
dotnet_diagnostic.S105.severity      = none # S105        : Tabulation characters should not be used
dotnet_diagnostic.S1135.severity     = none # S1135       : Track uses of "TODO" tags
dotnet_diagnostic.S1309.severity     = none # S1309       : Track uses of in-source issue suppressions
dotnet_diagnostic.S1451.severity     = none # S1451       : Track lack of copyright and license headers
dotnet_diagnostic.S2221.severity     = none # S2221       : "Exception" should not be caught
dotnet_diagnostic.S3990.severity     = none # S3990       : Assemblies should be marked as CLS compliant
dotnet_diagnostic.S3992.severity     = none # S3992       : Assemblies should explicitly specify COM visibility
dotnet_diagnostic.S4055.severity     = none # S4055       : Literals should not be passed as localized parameters
dotnet_diagnostic.SA1101.severity    = none # SA1101      : Prefix local calls with this
dotnet_diagnostic.SA1124.severity    = none # SA1124      : Do not use regions
dotnet_diagnostic.SA1309.severity    = none # SA1309      : Field names should not begin with underscore
dotnet_diagnostic.SA1412.severity    = none # SA1412      : Store files as UTF-8 with byte order mark
dotnet_diagnostic.SA1600.severity    = none # SA1600      : Elements should be documented
dotnet_diagnostic.SA1609.severity    = none # SA1609      : Property documentation should have value
dotnet_diagnostic.SA1611.severity    = none # SA1611      : Element parameters should be documented
dotnet_diagnostic.SA1615.severity    = none # SA1615      : Element return value should be documented
dotnet_diagnostic.SA1623.severity    = none # SA1623      : Property summary documentation should match accessors
dotnet_diagnostic.SA1633.severity    = none # SA1633      : File should have header